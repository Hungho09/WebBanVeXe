# API VeXe — SQLite trong volume /data (phù hợp migration SQLite hiện tại)
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src
COPY Backend/System.sln Backend/
COPY Backend/src Backend/src/
WORKDIR /src/Backend
RUN dotnet restore src/Api/Api.csproj
RUN dotnet publish src/Api/Api.csproj -c Release -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:9.0
WORKDIR /app
COPY --from=build /app/publish .
ENV ASPNETCORE_URLS=http://+:8080
ENV ASPNETCORE_ENVIRONMENT=Development
ENV ConnectionStrings__DefaultConnection=Data Source=/data/vexe.db
ENV Database__AutoMigrate=true
ENV DemoData__SeedOnStartup=true
EXPOSE 8080
VOLUME ["/data"]
ENTRYPOINT ["dotnet", "Api.dll"]
